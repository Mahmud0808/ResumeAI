# --- Auth (NextAuth / Auth.js v5) ---
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/ -> Credentials -> OAuth client)
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://resume-ai-app.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only needed if auto-detection of the deployment URL fails (e.g. behind a proxy).
# AUTH_URL=https://resume-ai-app.vercel.app

# --- Database ---
MONGODB_URL=

# --- AI ---
GEMINI_API_KEY=

# --- Email (SMTP) ---
# Used for email verification + password reset links. Provider-agnostic: use a
# DEDICATED mailbox (e.g. a new Gmail made for the app) so your personal address
# is never exposed. Free options that reach any recipient with no custom domain:
#   Gmail : SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  (SMTP_PASS = an App Password)
#   Brevo : SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
# If left unset, sends are skipped and the link is logged to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Shown to recipients in the From line — point it at the dedicated mailbox.
SMTP_FROM=ResumeAI <resumeai.mailer@gmail.com>

# Absolute app URL used to build links inside emails. AUTH_URL is reused if set;
# on Vercel, VERCEL_URL is detected automatically. Defaults to localhost:3000.
# AUTH_URL=https://resume-ai-app.vercel.app

BASE_URL=localhost:3000
